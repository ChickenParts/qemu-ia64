  limitations: {"FP-SEMANTICS": "F1 scalar decode is field-based, but host long double helpers still do not honor architectural precision control, FPSR rounding/flags, NaTVal, target/disabled-register faults or PSR dirty bits. Parallel F1 forms remain explicitly unimplemented.", "FP-STATE": "Numeric implementation present, not architecturally complete: NaTVal, illegal f0/f1 destination, disabled FP register faults and PSR.mfl/mfh must be checked.", "FP-COMPARE": "Only .s0 reaches the compare helper; .unc predicate-false clearing and FPSR/NaTVal semantics remain incorrect or absent.", "FP-APPROX": "Scalar frcpa now decodes independently of sf and p2, while rsqrt and parallel forms remain explicitly unimplemented. The reciprocal helper still uses host division and ignores numerator/special-case, FPSR and exception semantics.", "FP-BITOPS": "Scalar fmerge fast path mistakes general operands for fabs/fneg aliases; fallback merges binary64 bits instead of 82-bit FR fields. fsxt writes a noncanonical high word. Needs directed bitwise/NaTVal tests.", "FP-CONVERT": "Only scalar fcvt.fxu.trunc.s1 is dispatched; exception/status/NaTVal semantics remain incomplete.", "FP-BREAK": "Nonzero break.f falls into UNIMPL; the all-zero break.f word is silently skipped.", "HINT": "NOP/hint decode observed; hint no-op policy is allowed, but this emission audit is not an execution proof.", "MISSING": "No dedicated production implementation observed for this family."},
  aliases: {"fabs": "fmerge.s with f2=f0", "fnegabs": "fmerge.ns with f2=f0", "fneg": "fmerge.ns with f2=f3", "mov (FR)": "fmerge.s with f2=f3", "fadd.pc.sf": "fma.pc.sf with f4=f1", "fsub.pc.sf": "fms.pc.sf with f4=f1", "fmpy.pc.sf": "fma.pc.sf with f2=f0", "fnmpy.pc.sf": "fnma.pc.sf with f2=f0", "fnorm.pc.sf": "fma.pc.sf with f4=f1 and f2=f0", "fcvt.xuf.pc.sf": "fma.pc.sf with f4=f1 and f2=f0", "xmpy.*": "xma.* with f2=f0", "fcmp.neq/gt/ge/ord and negated relations": "operand/predicate permutations of canonical eq/lt/le/unord forms"},
