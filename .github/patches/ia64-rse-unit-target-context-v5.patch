diff --git a/tests/unit/meson.build b/tests/unit/meson.build
--- a/tests/unit/meson.build
+++ b/tests/unit/meson.build
@@ -183,7 +183,20 @@ foreach test_name, extra: tests
     src += test_ss.all_sources()
     deps += test_ss.all_dependencies()
   endif
-  exe = executable(test_name, src, genh, dependencies: deps)
+
+  test_c_args = []
+  test_include_directories = []
+  if test_name == 'test-ia64-rse'
+    # This test intentionally instantiates CPUIA64State.  Keep the target
+    # context local to this executable rather than making common unit tests
+    # appear to be per-target code.
+    test_c_args += ['-DCOMPILING_PER_TARGET', '-DTARGET_LONG_BITS=64']
+    test_include_directories += include_directories('../../target/ia64')
+  endif
+
+  exe = executable(test_name, src, genh, dependencies: deps,
+                   c_args: test_c_args,
+                   include_directories: test_include_directories)
 
   test(test_name, exe,
        depends: test_deps.get(test_name, []),
