diff --git a/target/ia64/rse.c b/target/ia64/rse.c
--- a/target/ia64/rse.c
+++ b/target/ia64/rse.c
@@ -51,3 +51,32 @@
 
     return -1;
 }
+
+IA64RSEReturnState ia64_rse_reconcile_return(
+    CPUIA64State *env, uint64_t ret_addr, uint64_t pfs_cfm,
+    IA64RSEPopWindowFn pop_window)
+{
+    IA64RSEReturnState result = {
+        .selected = -1,
+    };
+    unsigned int drop_count = 0;
+
+    if (!env || !pop_window || env->rse_depth == 0) {
+        return result;
+    }
+
+    result.selected = ia64_rse_find_return_frame(env, ret_addr, pfs_cfm);
+    if (result.selected >= 0) {
+        drop_count = env->rse_depth - (unsigned int)result.selected - 1;
+    }
+
+    while (result.dropped < drop_count) {
+        if (!pop_window(env)) {
+            return result;
+        }
+        result.dropped++;
+    }
+
+    result.restored = pop_window(env);
+    return result;
+}
diff --git a/target/ia64/rse.h b/target/ia64/rse.h
