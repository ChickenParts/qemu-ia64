+++ b/target/ia64/rse.h
@@ -8,6 +8,14 @@
 #define TARGET_IA64_RSE_H
 
 #include "cpu.h"
+
+typedef bool (*IA64RSEPopWindowFn)(CPUIA64State *env);
+
+typedef struct IA64RSEReturnState {
+    int selected;
+    unsigned int dropped;
+    bool restored;
+} IA64RSEReturnState;
 
 /*
  * Locate the shadow call frame selected by a br.ret.
@@ -20,4 +28,15 @@
 int ia64_rse_find_return_frame(const CPUIA64State *env,
                                uint64_t ret_addr, uint64_t pfs_cfm);
 
+/*
+ * Pop intervening shadow frames and restore the frame selected by br.ret.
+ *
+ * When no shadow frame matches, preserve the legacy local-return behavior by
+ * popping only the newest frame.  The callback is the target's architectural
+ * pop implementation, so production and unit tests share the orchestration.
+ */
+IA64RSEReturnState ia64_rse_reconcile_return(
+    CPUIA64State *env, uint64_t ret_addr, uint64_t pfs_cfm,
+    IA64RSEPopWindowFn pop_window);
+
 #endif /* TARGET_IA64_RSE_H */
diff --git a/tests/unit/test-ia64-rse.c b/tests/unit/test-ia64-rse.c
--- a/tests/unit/test-ia64-rse.c
+++ b/tests/unit/test-ia64-rse.c
@@ -8,85 +8,200 @@
 #include "qemu/osdep.h"
 #include "target/ia64/rse.h"
 
+#define MAX_TEST_POPS 8
+
+static unsigned int pop_count;
+static uint64_t popped_returns[MAX_TEST_POPS];
+
+static void seed_frame(struct IA64RSEFrame *frame, uint64_t tag,
+                       uint64_t ret_addr, uint64_t cfm)
+{
+    size_t index;
+
+    frame->ret_addr = ret_addr;
+    frame->cfm = cfm;
+    frame->ar_pfs = (tag << 48) | cfm;
+    for (index = 0; index < G_N_ELEMENTS(frame->r); index++) {
+        frame->r[index] = (tag << 32) | index;
+        frame->nat[index] = (tag + index) & 1;
+    }
+}
+
 static void init_frames(CPUIA64State *env,
                         struct IA64RSEFrame *frames,
                         size_t count)
 {
     memset(env, 0, sizeof(*env));
     memset(frames, 0, sizeof(*frames) * count);
+    memset(popped_returns, 0, sizeof(popped_returns));
+    pop_count = 0;
     env->rse_frames = frames;
     env->rse_depth = count;
+    env->rse_capacity = count;
+    memset(env->r + 32, 0xa5, sizeof(frames[0].r));
+    memset(env->nat + 32, 0x5a, sizeof(frames[0].nat));
+}
+
+static bool test_pop_window(CPUIA64State *env)
+{
+    struct IA64RSEFrame *frame;
+
+    if (!env->rse_frames || env->rse_depth == 0) {
+        return false;
+    }
+
+    frame = &env->rse_frames[env->rse_depth - 1];
+    if (pop_count < G_N_ELEMENTS(popped_returns)) {
+        popped_returns[pop_count] = frame->ret_addr;
+    }
+    pop_count++;
+
+    memcpy(env->r + 32, frame->r, sizeof(frame->r));
+    memcpy(env->nat + 32, frame->nat, sizeof(frame->nat));
+    env->ar[IA64_AR_PFS] = frame->ar_pfs;
+    env->cfm = frame->cfm;
+    env->rse_depth--;
+    return true;
+}
+
+static void assert_frame_restored(const CPUIA64State *env,
+                                  const struct IA64RSEFrame *frame)
+{
+    g_assert_cmpmem(env->r + 32, sizeof(frame->r),
+                    frame->r, sizeof(frame->r));
+    g_assert_cmpmem(env->nat + 32, sizeof(frame->nat),
+                    frame->nat, sizeof(frame->nat));
+    g_assert_cmphex(env->ar[IA64_AR_PFS], ==, frame->ar_pfs);
+    g_assert_cmphex(env->cfm, ==, frame->cfm);
 }
 
 static void test_empty(void)
 {
     CPUIA64State env = { 0 };
-
-    g_assert_cmpint(ia64_rse_find_return_frame(&env, 0x1000, 0x301), ==, -1);
+    IA64RSEReturnState state;
+
+    state = ia64_rse_reconcile_return(&env, 0x1000, 0x301,
+                                      test_pop_window);
+    g_assert_cmpint(state.selected, ==, -1);
+    g_assert_cmpuint(state.dropped, ==, 0);
+    g_assert_false(state.restored);
+    g_assert_cmpuint(pop_count, ==, 0);
 }
 
