diff --git a/tests/unit/test-ia64-rse.c b/tests/unit/test-ia64-rse.c
new file mode 100644
index 0000000..80ff296
--- /dev/null
+++ b/tests/unit/test-ia64-rse.c
@@ -0,0 +1,101 @@
+/*
+ * IA-64 register stack return-frame tests
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "target/ia64/rse.h"
+
+static void init_frames(CPUIA64State *env,
+                        struct IA64RSEFrame *frames,
+                        size_t count)
+{
+    memset(env, 0, sizeof(*env));
+    memset(frames, 0, sizeof(*frames) * count);
+    env->rse_frames = frames;
+    env->rse_depth = count;
+}
+
+static void test_empty(void)
+{
+    CPUIA64State env = { 0 };
+
+    g_assert_cmpint(ia64_rse_find_return_frame(&env, 0x1000, 0x301), ==, -1);
+}
+
+static void test_top_return_address(void)
+{
+    CPUIA64State env;
+    struct IA64RSEFrame frames[2];
+
+    init_frames(&env, frames, G_N_ELEMENTS(frames));
+    frames[0].ret_addr = 0x1000;
+    frames[0].cfm = 0x201;
+    frames[1].ret_addr = 0x2000;
+    frames[1].cfm = 0x302;
+
+    g_assert_cmpint(ia64_rse_find_return_frame(&env, 0x2002, 0x302), ==, 1);
+}
+
+static void test_nonlocal_return_address_wins(void)
+{
+    CPUIA64State env;
+    struct IA64RSEFrame frames[3];
+
+    init_frames(&env, frames, G_N_ELEMENTS(frames));
+    frames[0].ret_addr = 0x1000;
+    frames[0].cfm = 0x201;
+    frames[1].ret_addr = 0x3000;
+    frames[1].cfm = 0x30a;
+    frames[2].ret_addr = 0x4000;
+    frames[2].cfm = 0x30a;
+
+    /*
+     * The newest frame deliberately has the same CFM.  The older exact return
+     * address must win for a non-local return or continuation transfer.
+     */
+    g_assert_cmpint(ia64_rse_find_return_frame(&env, 0x3001, 0x30a), ==, 1);
+}
+
+static void test_pfs_fallback(void)
+{
+    CPUIA64State env;
+    struct IA64RSEFrame frames[3];
+
+    init_frames(&env, frames, G_N_ELEMENTS(frames));
+    frames[0].ret_addr = 0x1000;
+    frames[0].cfm = 0x201;
+    frames[1].ret_addr = 0x2000;
+    frames[1].cfm = 0x30a;
+    frames[2].ret_addr = 0x3000;
+    frames[2].cfm = 0x38a;
+
+    g_assert_cmpint(ia64_rse_find_return_frame(&env, 0x9000, 0x30a), ==, 1);
+}
+
+static void test_no_match(void)
+{
+    CPUIA64State env;
+    struct IA64RSEFrame frames[2];
+
+    init_frames(&env, frames, G_N_ELEMENTS(frames));
+    frames[0].ret_addr = 0x1000;
+    frames[0].cfm = 0x201;
+    frames[1].ret_addr = 0x2000;
+    frames[1].cfm = 0x302;
+
+    g_assert_cmpint(ia64_rse_find_return_frame(&env, 0x9000, 0x777), ==, -1);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/ia64/rse/empty", test_empty);
+    g_test_add_func("/ia64/rse/top-return-address", test_top_return_address);
+    g_test_add_func("/ia64/rse/nonlocal-return-address-wins",
+                    test_nonlocal_return_address_wins);
+    g_test_add_func("/ia64/rse/pfs-fallback", test_pfs_fallback);
+    g_test_add_func("/ia64/rse/no-match", test_no_match);
+    return g_test_run();
+}
