diff --git a/target/ia64/rse.c b/target/ia64/rse.c
new file mode 100644
index 0000000..ae41a71
--- /dev/null
+++ b/target/ia64/rse.c
@@ -0,0 +1,52 @@
+/*
+ * IA-64 register stack engine helpers
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "rse.h"
+
+#define IA64_RSE_CFM_MASK ((UINT64_C(1) << 46) - 1)
+
+int ia64_rse_find_return_frame(const CPUIA64State *env,
+                               uint64_t ret_addr, uint64_t pfs_cfm)
+{
+    uint64_t target = ret_addr & ~UINT64_C(0xf);
+    uint64_t caller_cfm = pfs_cfm & IA64_RSE_CFM_MASK;
+    int index;
+
+    if (!env->rse_frames || env->rse_depth == 0) {
+        return -1;
+    }
+
+    /*
+     * The return address is the strongest identity.  Search it first so an
+     * intervening frame with the same CFM cannot capture a non-local return.
+     */
+    if (target != 0) {
+        for (index = (int)env->rse_depth - 1; index >= 0; index--) {
+            const struct IA64RSEFrame *frame = &env->rse_frames[index];
+
+            if (frame->ret_addr != 0 &&
+                (frame->ret_addr & ~UINT64_C(0xf)) == target) {
+                return index;
+            }
+        }
+    }
+
+    /*
+     * ar.pfs supplies the caller CFM even when a return branch register was
+     * not tracked precisely.  It is a safe fallback, but is less selective
+     * because unrelated procedures often use identical frame shapes.
+     */
+    for (index = (int)env->rse_depth - 1; index >= 0; index--) {
+        const struct IA64RSEFrame *frame = &env->rse_frames[index];
+
+        if ((frame->cfm & IA64_RSE_CFM_MASK) == caller_cfm) {
+            return index;
+        }
+    }
+
+    return -1;
+}
diff --git a/target/ia64/rse.h b/target/ia64/rse.h
new file mode 100644
index 0000000..9bd24d5
--- /dev/null
+++ b/target/ia64/rse.h
@@ -0,0 +1,22 @@
+/*
+ * IA-64 register stack engine helpers
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef TARGET_IA64_RSE_H
+#define TARGET_IA64_RSE_H
+
+#include "cpu.h"
+
+/*
+ * Locate the shadow call frame selected by a br.ret.
+ *
+ * The architectural return state is carried by the branch target and ar.pfs;
+ * it is not necessarily the newest shadow frame.  Stack-switch and
+ * continuation paths can deliberately discard one or more intervening calls.
+ * Return the selected frame index, or -1 when no shadow frame matches.
+ */
+int ia64_rse_find_return_frame(const CPUIA64State *env,
+                               uint64_t ret_addr, uint64_t pfs_cfm);
+
+#endif /* TARGET_IA64_RSE_H */
