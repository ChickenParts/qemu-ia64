diff --git a/tests/qtest/ia64-ipf-test.c b/tests/qtest/ia64-ipf-test.c
index b906034..13f1697 100644
--- a/tests/qtest/ia64-ipf-test.c
+++ b/tests/qtest/ia64-ipf-test.c
@@ -51,6 +51,14 @@
 #define TEST_PM_IO_BASE             0x0400
 #define TEST_PM_TIMER_OFFSET        0x08
 #define TEST_PM_TIMER_MASK          0x00ffffffU
+#define TEST_FDC_MSR                 0x3f4
+#define TEST_PARALLEL_STATUS         0x379
+#define TEST_FDC_RQM                 0x80
+#define TEST_PARALLEL_RESET_STATUS   0xd9
+#define TEST_CMOS_INDEX              0x70
+#define TEST_CMOS_DATA               0x71
+#define TEST_CMOS_FLOPPY             0x10
+#define TEST_CMOS_EQUIPMENT          0x14
 #define TEST_E1000_MMIO_BASE        UINT64_C(0x10000000)
 #define E1000_ICR                   0x00c0
 #define E1000_ICS                   0x00c8
@@ -159,6 +167,35 @@ static QTestState *ipf_qtest_start(void)
     return ipf_qtest_start_args("");
 }
 
+static uint8_t cmos_read(QTestState *qts, uint8_t index)
+{
+    qtest_writeb(qts, legacy_io_address(TEST_CMOS_INDEX), index);
+    return qtest_readb(qts, legacy_io_address(TEST_CMOS_DATA));
+}
+
+static void test_legacy_peripherals(void)
+{
+    QTestState *qts = ipf_qtest_start_args(
+        "-drive if=floppy,file=null-co://,file.read-zeroes=on,"
+        "format=raw,size=1440k -parallel null");
+    uint8_t equipment;
+    uint8_t parallel_status;
+
+    g_assert_cmphex(qtest_readb(qts, legacy_io_address(TEST_FDC_MSR)),
+                    ==, TEST_FDC_RQM);
+    g_assert_cmphex(cmos_read(qts, TEST_CMOS_FLOPPY), ==, 0x40);
+
+    equipment = cmos_read(qts, TEST_CMOS_EQUIPMENT);
+    g_assert_cmphex(equipment & 0x01, ==, 0x01);
+    g_assert_cmphex(equipment & 0xc0, ==, 0);
+
+    parallel_status = qtest_readb(
+        qts, legacy_io_address(TEST_PARALLEL_STATUS));
+    g_assert_cmphex(parallel_status, ==, TEST_PARALLEL_RESET_STATUS);
+
+    qtest_quit(qts);
+}
