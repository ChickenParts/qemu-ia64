+static void ipf_init_legacy_peripherals(IPFMachineState *m)
+{
+    parallel_hds_isa_init(m->isa_bus, MAX_PARALLEL_PORTS);
+
+#ifdef CONFIG_FDC_ISA
+    DriveInfo *fd[MAX_FD];
+    bool create_fdc = defaults_enabled();
+
+    for (unsigned int i = 0; i < MAX_FD; i++) {
+        fd[i] = drive_get(IF_FLOPPY, 0, i);
+        create_fdc |= fd[i] != NULL;
+    }
+
+    if (create_fdc) {
+        m->fdc = isa_new(TYPE_ISA_FDC);
+        isa_realize_and_unref(m->fdc, m->isa_bus, &error_fatal);
+        isa_fdc_init_drives(m->fdc, fd);
+    }
+#endif
