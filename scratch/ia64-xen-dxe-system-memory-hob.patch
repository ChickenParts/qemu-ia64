+                  "IA64: pei_sysmem_hob_fix inserted base=%016" PRIx64
+                  " len=%016" PRIx64 " end=%016" PRIx64
+                  " free_bottom=%016" PRIx64 " hobs=%d\n",
+                  mem_bottom, mem_top - mem_bottom, new_end_hob,
+                  new_free_bottom, validated_count);
+    return true;
+}
